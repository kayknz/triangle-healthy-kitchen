NODE_ENV=production
HOST=127.0.0.1
PORT=4173
THK_PUBLIC_ORIGIN=https://trianglehk.com
THK_DATABASE_PATH=/var/lib/trianglehk/triangle-health.db

# Generate a unique secret with at least 64 characters. Never commit the value.
THK_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Use unique passwords of at least 14 characters for every team role.
THK_CEO_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
THK_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
THK_TRANSPORT_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
THK_KITCHEN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
THK_DRIVER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD

# Twilio Verify production SMS credentials.
TWILIO_API_KEY=REPLACE_WITH_TWILIO_API_KEY
TWILIO_API_KEY_SECRET=REPLACE_WITH_TWILIO_API_KEY_SECRET
TWILIO_VERIFY_SERVICE_SID=REPLACE_WITH_VERIFY_SERVICE_SID
